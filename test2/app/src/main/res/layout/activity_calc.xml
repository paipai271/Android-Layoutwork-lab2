<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--标题栏-->
    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#27ae90"
        android:text="ConstraintLayoutTest"
        android:textColor="#ffffff"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        app:layout_constraintTop_toTopOf="parent"/>

    <!--输入显示区域 Input  0.0 -->
    <LinearLayout
        android:id="@+id/display_layout"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/title">
        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Input"
            android:textSize="22sp"
            android:gravity="center_vertical"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="0.0"
            android:textSize="22sp"
            android:gravity="center_vertical"/>
    </LinearLayout>

    <!--第一行按键7 8 9 ÷ -->
    <Button
        android:id="@+id/btn7"
        android:text="7"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintTop_toBottomOf="@id/display_layout"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/btn8"
        app:layout_constraintHorizontal_weight="1"/>
    <Button
        android:id="@+id/btn8"
        android:text="8"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="@id/btn7"
        app:layout_constraintLeft_toRightOf="@id/btn7"
        app:layout_constraintRight_toLeftOf="@id/btn9"
        app:layout_constraintHorizontal_weight="1"/>
    <Button
        android:id="@+id/btn9"
        android:text="9"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="@id/btn7"
        app:layout_constraintLeft_toRightOf="@id/btn8"
        app:layout_constraintRight_toLeftOf="@id/btn_div"
        app:layout_constraintHorizontal_weight="1"/>
    <Button
        android:id="@+id/btn_div"
        android:text="÷"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="@id/btn7"
        app:layout_constraintLeft_toRightOf="@id/btn9"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintHorizontal_weight="1"/>

    <!--第二行4 5 6 × -->
    <Button
        android:id="@+id/btn4"
        android:text="4"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintTop_toBottomOf="@id/btn7"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/btn5"
        app:layout_constraintHorizontal_weight="1"/>
    <Button
        android:id="@+id/btn5"
        android:text="5"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="@id/btn4"
        app:layout_constraintLeft_toRightOf="@id/btn4"
        app:layout_constraintRight_toLeftOf="@id/btn6"
        app:layout_constraintHorizontal_weight="1"/>
    <Button
        android:id="@+id/btn6"
        android:text="6"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="@id/btn4"
        app:layout_constraintLeft_toRightOf="@id/btn5"
        app:layout_constraintRight_toLeftOf="@id/btn_mul"
        app:layout_constraintHorizontal_weight="1"/>
    <Button
        android:id="@+id/btn_mul"
        android:text="×"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="@id/btn4"
        app:layout_constraintLeft_toRightOf="@id/btn6"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintHorizontal_weight="1"/>

    <!--第三行1 2 3 + -->
    <Button
        android:id="@+id/btn1"
        android:text="1"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintTop_toBottomOf="@id/btn4"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/btn2"
        app:layout_constraintHorizontal_weight="1"/>
    <Button
        android:id="@+id/btn2"
        android:text="2"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="@id/btn1"
        app:layout_constraintLeft_toRightOf="@id/btn1"
        app:layout_constraintRight_toLeftOf="@id/btn3"
        app:layout_constraintHorizontal_weight="1"/>
    <Button
        android:id="@+id/btn3"
        android:text="3"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="@id/btn1"
        app:layout_constraintLeft_toRightOf="@id/btn2"
        app:layout_constraintRight_toLeftOf="@id/btn_plus"
        app:layout_constraintHorizontal_weight="1"/>
    <Button
        android:id="@+id/btn_plus"
        android:text="+"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="@id/btn1"
        app:layout_constraintLeft_toRightOf="@id/btn3"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintHorizontal_weight="1"/>

    <!--第四行 . 0 = - -->
    <Button
        android:id="@+id/btn_dot"
        android:text="."
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintTop_toBottomOf="@id/btn1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/btn0"
        app:layout_constraintHorizontal_weight="1"/>
    <Button
        android:id="@+id/btn0"
        android:text="0"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="@id/btn_dot"
        app:layout_constraintLeft_toRightOf="@id/btn_dot"
        app:layout_constraintRight_toLeftOf="@id/btn_eq"
        app:layout_constraintHorizontal_weight="1"/>
    <Button
        android:id="@+id/btn_eq"
        android:text="="
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="@id/btn_dot"
        app:layout_constraintLeft_toRightOf="@id/btn0"
        app:layout_constraintRight_toLeftOf="@id/btn_minus"
        app:layout_constraintHorizontal_weight="1"/>
    <Button
        android:id="@+id/btn_minus"
        android:text="-"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="@id/btn_dot"
        app:layout_constraintLeft_toRightOf="@id/btn_eq"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintHorizontal_weight="1"/>

</androidx.constraintlayout.widget.ConstraintLayout>
